HOST=127.0.0.1
PORT=3001
PUBLIC_URL=http://localhost:5173
DATABASE_PATH=./data/wetrack.sqlite
# Local mode is bound to loopback. For deployment set a strong password.
# ADMIN_PASSWORD=
# META_GRAPH_VERSION=   # Required: select a supported version in your Meta app.
# META_APP_ID=          # OAuth: Meta application ID.
# META_APP_SECRET=      # OAuth: keep only on the server, never in VITE_* variables.
# META_LOGIN_CONFIG_ID= # Optional Facebook Login for Business configuration ID.
# OAuth requires PUBLIC_URL=https://your-domain and the exact callback registered in Meta:
# https://your-domain/api/meta/oauth/callback
# SECRETS_KEY=          # Optional: 64 hex characters. Otherwise data/secret.key is created.
# RULES_CRON_SECRET=    # Private bearer key for /api/internal/rules-run (GitHub Actions).
