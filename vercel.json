{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "functions": { "api/index.mjs": { "maxDuration": 300, "includeFiles": "server/pixel.js" } },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/pixel.js", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/internal/capi-drain", "schedule": "0 6 * * *" }]
}
